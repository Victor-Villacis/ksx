{
  "id": "matrix",
  "label": "Matrix",
  "scheme": "dark",
  "blurb": "Phosphor green on near-black, in a monospace face — dark, whatever the system prefers.",
  "note": "/* ── Matrix: phosphor green on near-black — the terminal the cabinet\n   pretends to be. TK3's proof theme: one JSON file, zero component edits.\n   The hue roles invert the KSX default on purpose (green IS the accent\n   here; ok leans teal so state and liveness stay two different words), the\n   UI face goes mono, and motion tightens. Every pair below passes the same\n   contrast gate as the base palette or is pinned there as an exemption. ── */",
  "tokens": [
    { "cssName": "color-scheme", "$value": "dark", "$type": "other" },
    { "cssName": "--bg", "$value": "#041008", "$type": "color" },
    { "cssName": "--bg-2", "$value": "#020a05", "$type": "color" },
    { "cssName": "--panel", "$value": "#071810", "$type": "color" },
    { "cssName": "--panel-2", "$value": "#05130c", "$type": "color" },
    { "cssName": "--panel-3", "$value": "#0b2015", "$type": "color" },
    { "cssName": "--line", "$value": "#14432a", "$type": "color" },
    { "cssName": "--line-soft", "$value": "#0e3320", "$type": "color" },
    { "cssName": "--line-strong", "$value": "#1e5c39", "$type": "color" },
    { "cssName": "--text", "$value": "#d8ffe0", "$type": "color" },
    { "cssName": "--text-2", "$value": "#93d8a5", "$type": "color" },
    { "cssName": "--text-3", "$value": "#6aad7f", "$type": "color" },
    { "cssName": "--accent", "$value": "#2fe86b", "$type": "color" },
    { "cssName": "--accent-strong", "$value": "#5cff8f", "$type": "color" },
    { "cssName": "--accent-fill", "$value": "#2fe86b", "$type": "color" },
    { "cssName": "--accent-on", "$value": "#01230e", "$type": "color" },
    { "cssName": "--accent-dim", "$value": "rgba(47, 232, 107, 0.13)", "$type": "color" },
    { "cssName": "--accent-dim-2", "$value": "rgba(47, 232, 107, 0.22)", "$type": "color" },
    { "cssName": "--accent-line", "$value": "rgba(47, 232, 107, 0.42)", "$type": "color" },
    { "cssName": "--accent-glow", "$value": "rgba(47, 232, 107, 0.16)", "$type": "color" },
    { "cssName": "--cool", "$value": "#b09fff", "$type": "color" },
    { "cssName": "--cool-line", "$value": "rgba(176, 159, 255, 0.45)", "$type": "color" },
    { "cssName": "--ok", "$value": "#59e0b8", "$type": "color" },
    { "cssName": "--ok-dim", "$value": "rgba(89, 224, 184, 0.12)", "$type": "color" },
    { "cssName": "--ok-line", "$value": "rgba(89, 224, 184, 0.4)", "$type": "color" },
    { "cssName": "--warn", "$value": "#f0c94a", "$type": "color" },
    { "cssName": "--warn-dim", "$value": "rgba(240, 201, 74, 0.12)", "$type": "color" },
    { "cssName": "--warn-line", "$value": "rgba(240, 201, 74, 0.42)", "$type": "color" },
    { "cssName": "--danger", "$value": "#ff6659", "$type": "color" },
    { "cssName": "--danger-fill", "$value": "#b3271e", "$type": "color" },
    { "cssName": "--danger-on", "$value": "#fff2f0", "$type": "color" },
    { "cssName": "--danger-dim", "$value": "rgba(255, 102, 89, 0.12)", "$type": "color" },
    { "cssName": "--danger-line", "$value": "rgba(255, 102, 89, 0.44)", "$type": "color" },
    { "cssName": "--focus", "$value": "#6fffa0", "$type": "color" },
    { "cssName": "--overlay-scrim", "$value": "rgba(1, 8, 4, 0.78)", "$type": "color" },
    { "cssName": "--sel-tint", "$value": "rgba(47, 232, 107, 0.06)", "$type": "color" },
    { "cssName": "--e-1", "$value": "0 1px 2px rgba(0, 0, 0, 0.5)", "$type": "other" },
    { "cssName": "--e-2", "$value": "0 1px 2px rgba(0, 0, 0, 0.5), 0 4px 12px -4px rgba(0, 0, 0, 0.6)", "$type": "other" },
    { "cssName": "--e-3", "$value": "0 2px 6px rgba(0, 0, 0, 0.5), 0 12px 28px -8px rgba(0, 0, 0, 0.7)", "$type": "other" },
    { "cssName": "--e-4", "$value": "0 4px 10px rgba(0, 0, 0, 0.55), 0 28px 64px -16px rgba(0, 0, 0, 0.8)", "$type": "other" },
    { "cssName": "--ground", "$value": "radial-gradient(1200px 620px at 50% -10%, #0a2413 0%, transparent 70%), linear-gradient(180deg, #041008 0%, #020a05 100%)", "$type": "other" },
    { "comment": "  /* Look-and-feel overrides (themeable: \"optional\"): the terminal face\n     and tighter motion. Radii stay — sharpness here comes from the palette\n     and the mono face, not from re-cutting every corner. */" },
    { "cssName": "--font-sans", "$value": "ui-monospace, \"Cascadia Mono\", \"Cascadia Code\", Consolas, monospace", "$type": "other" },
    { "cssName": "--dur-1", "$value": "60ms", "$type": "other" },
    { "cssName": "--dur-2", "$value": "110ms", "$type": "other" },
    { "cssName": "--dur-3", "$value": "180ms", "$type": "other" }
  ]
