<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <AssemblyName>ksx-hidmaestro-fake-host-pure-tests</AssemblyName>
    <RootNamespace>Ksx.HidMaestroFakeHost.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../hidmaestro-probe/HostProtocolCodec.cs"
             Link="Protocol/HostProtocolCodec.cs" />
    <Compile Include="../LaunchArguments.cs" Link="Runtime/LaunchArguments.cs" />
    <Compile Include="../FakePinnedIdentity.cs" Link="Runtime/FakePinnedIdentity.cs" />
    <Compile Include="../FakeSink.cs" Link="Runtime/FakeSink.cs" />
    <Compile Include="../FakeFeedbackQueue.cs" Link="Runtime/FakeFeedbackQueue.cs" />
    <Compile Include="../FakeHostSession.cs" Link="Runtime/FakeHostSession.cs" />
    <Compile Include="../FakeHostSummary.cs" Link="Runtime/FakeHostSummary.cs" />
    <Compile Include="../PipeFrameStream.cs" Link="Runtime/PipeFrameStream.cs" />
  </ItemGroup>

  <Target Name="EnforceSdkFreeFakeHostTests" BeforeTargets="CoreCompile">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\test-safety.ps1&quot;" />
  </Target>
</Project>
