    "hostAssignment": {
      "X": "leftStickX",
      "Y": "leftStickY",
      "Z": "rightStickX",
      "Rz": "rightStickY",
      "Rx": "leftTrigger",
      "Ry": "rightTrigger"
    },
    "descriptorAssignment": {
