<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <AssemblyName>ksx-hidmaestro-probe</AssemblyName>
    <RootNamespace>Ksx.HidMaestroProbe</RootNamespace>
    <HIDMaestroCorePath Condition="'$(HIDMaestroCorePath)' == ''">$(HIDMAESTRO_CORE_PATH)</HIDMaestroCorePath>
  </PropertyGroup>

  <ItemGroup Condition="Exists('$(HIDMaestroCorePath)')">
    <!-- This compile-time reference is always supplied from an extracted,
         hash-pinned upstream release. The SDK binary is never vendored. -->
    <Reference Include="HIDMaestro.Core">
      <HintPath>$(HIDMaestroCorePath)</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Remove="sdk.lock.json" />
    <EmbeddedResource Include="sdk.lock.json" LogicalName="Ksx.HidMaestroProbe.sdk.lock.json" />
  </ItemGroup>

  <Target Name="ValidatePinnedSdk" BeforeTargets="ResolveReferences">
    <Error Condition="'$(HIDMaestroCorePath)' == ''"
           Text="Set HIDMaestroCorePath (or HIDMAESTRO_CORE_PATH) to the extracted HIDMaestro v1.6.1 HIDMaestro.Core.dll." />
    <Error Condition="!Exists('$(HIDMaestroCorePath)')"
           Text="HIDMaestro.Core.dll was not found at '$(HIDMaestroCorePath)'." />
    <GetFileHash Files="$(HIDMaestroCorePath)" Algorithm="SHA256"
                 Condition="Exists('$(HIDMaestroCorePath)')">
      <Output TaskParameter="Hash" PropertyName="_HIDMaestroCoreActualSha256" />
    </GetFileHash>
    <Error Condition="Exists('$(HIDMaestroCorePath)') and '$(_HIDMaestroCoreActualSha256)' != 'ADADD9E2604B7B6B047F386EBDD03879FEEF48009C6290281E4C665E2190F6D5'"
           Text="HIDMaestro.Core.dll SHA-256 mismatch. Expected the official v1.6.1 release DLL; got $(_HIDMaestroCoreActualSha256)." />
  </Target>

  <Target Name="EnforceReadOnlyProbe" BeforeTargets="CoreCompile">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\test-safety.ps1&quot;" />
  </Target>
</Project>
